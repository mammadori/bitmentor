# signet or mainnet: the only setting that picks the network
NETWORK=signet
# The name of the site. Absolute links (register and login QR codes, sign,
# email, sitemap, canonical, previews) are always https://SITE_HOST, even from the onion or
# behind a proxy
SITE_HOST=
# development (the site only for DEV_ALLOWED_IPS, the under-construction page for the others),
# maintenance (the under-construction page for everyone), production (mainnet only)
SITE_MODE=development
# 1: lets `manage.py demo_data` (made-up shops for training) run on an EMPTY site in maintenance mode too. Development
# mode needs no setting; mainnet, production and a site with a real shop or account are always refused
BITMENTOR_DEMO=
# 1: the register sees on-chain payments in the site's own fake explorer, where /dev/explorer/ pretends to pay. For the
# test site on signet only; refused on mainnet
FAKE_EXPLORER=
# Addresses, separated by spaces, that see the site in development
DEV_ALLOWED_IPS=
# on: in development mode the team also gets in by signing with a Lightning wallet, from any address: invites and keys
# in /admin/ (docs/features/team-access.md). off: nothing of it exists
TEAM_ACCESS=off
# Paths open to everyone in every mode, for example /extra /extra/*
OPEN_PATHS=
# Addresses or networks, separated by spaces, that can reach /admin/: empty, from anywhere (set it: /admin/ has no second factor)
ADMIN_ALLOWED_IPS=
# on: Caddy access log, addresses reduced to their network, 7 days. off: no log
ACCESS_LOG=off
# What the logs keep of an address (prefix length; 32/128: all of it), how long the access log stays, Docker's log size
# LOG_IPV4_MASK=24
# LOG_IPV6_MASK=48
# ACCESS_LOG_KEEP=168h
# LOG_MAX_SIZE=20m
# LOG_MAX_FILE=5
# Folder with the under-construction page (index.html): without it, the software's own
MAINTENANCE_DIR=
# Community folder
COMMUNITY_DIR=./examples/community
# Generate all of them: openssl rand -hex 32. The first start sets the two Postgres passwords for good
SECRET_KEY=
POSTGRES_PASSWORD=
WEB_DB_PASSWORD=
# Behind a proxy that holds TLS: SITE_SCHEME=http and the proxy's network in TRUSTED_PROXIES
SITE_SCHEME=https
TRUSTED_PROXIES=
# One day while trying out the domain, one year (31536000) in production
HSTS_SECONDS=86400
# IPv6 for the stack's network: a ULA /64 of its own, for example fd12:3456:789a:1::/64 (docs/configuration.md, IPv6)
IPV6_SUBNET=
# The site's onion address, http://<56 letters>.onion, announced to browsers that support Tor
ONION_LOCATION=
# Gunicorn processes and threads. If unset: 3 and 8, for a 4-CPU machine (config/gunicorn.py)
# WEB_CONCURRENCY=3
# WEB_THREADS=8
# At most one change of a shop's Lightning address by its owner every this many days (docs/features/address-change.md)
# LIGHTNING_CHANGE_DAYS=7
# Optional. Without a mail server, login links are not sent; on signet they are written to the web container's log
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
TELEGRAM_BOT_TOKEN=
# The moderators' chat: a chat number or an @name. Lightning addresses that stop, requests for help and the
# morning summary. Without it, the summary goes to the community's email and the rest is only in /admin/
TELEGRAM_MODERATION_CHAT=
# The community's Nostr key and relays (separated by commas), for manage.py publish_nostr
NOSTR_SECRET_KEY=
NOSTR_RELAYS=
# OSM_TOKEN is never written here: pass it by hand for one run of osm_upload (docs/features/openstreetmap.md)

# Where the source of the version this site runs is, linked on every page (AGPLv3; COPYING.md says where); upstream by default
# SOURCE_URL=https://github.com/mammadori/bitmentor
