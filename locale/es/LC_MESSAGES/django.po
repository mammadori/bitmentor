msgid "Changed: {what}."
msgstr "Cambiado: {what}."

#, python-brace-format
msgid "The register: {link}"
msgstr "El registro: {link}"

msgid "shops"
msgstr "tiendas"

msgid "what changed"
msgstr "qué ha cambiado"

msgid "who"
msgstr "quién"

msgid "when"
msgstr "cuándo"

msgid "account"
msgstr "cuenta"

msgid "told"
msgstr "avisados"

msgid "not told"
msgstr "no avisados"

#, python-brace-format
msgid "The account of {shops} was changed from {via} by {actor}."
msgstr "La cuenta de {shops} se ha modificado {via} (usuario: {actor})."

#, python-brace-format
