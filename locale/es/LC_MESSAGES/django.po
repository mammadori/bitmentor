msgid "January"
msgstr "enero"

msgid "February"
msgstr "febrero"

msgid "March"
msgstr "marzo"

msgid "April"
msgstr "abril"

msgid "May"
msgstr "mayo"

msgid "June"
msgstr "junio"

msgid "July"
msgstr "julio"

msgid "August"
msgstr "agosto"

msgid "September"
msgstr "septiembre"

msgid "October"
msgstr "octubre"

msgid "November"
msgstr "noviembre"

msgid "December"
msgstr "diciembre"

msgid "Status"
msgstr "Estado"

msgid "Payment method"
msgstr "Forma de pago"

msgid "Description"
msgstr "Descripción"

msgid "Month"
msgstr "Mes"

msgid "Map of the places"
msgstr "Mapa de los lugares"

msgid "Zoom in"
msgstr "Acercar"

msgid "Zoom out"
msgstr "Alejar"

msgid "Close"
msgstr "Cerrar"

msgid "A JavaScript library for interactive maps"
msgstr "Una biblioteca JavaScript para mapas interactivos"

#, python-format
msgid "%(discount)s%% discount"
msgstr "%(discount)s %% de descuento"

#, python-format
msgid "%(number)s places: zoom in"
msgstr "%(number)s lugares: acerca el mapa"

msgid "Skip the map: go to the list"
msgstr "Saltar el mapa: ir a la lista"

msgid "Getting the exchange rate..."
msgstr "Consultando el tipo de cambio..."

msgid "Asking your Lightning wallet for the invoice..."
msgstr "Pidiendo la solicitud de pago a tu wallet Lightning..."

#, python-brace-format
msgid "Exchange rate: {rate} ({sources})."
msgstr "Tipo de cambio: {rate} ({sources})."

#, python-brace-format
msgid ""
"The two sources do not agree: {first} and {second}. Which rate do you want "
"to use?"
msgstr ""
"Las dos fuentes no coinciden: {first} y {second}. ¿Qué tipo de cambio "
"quieres usar?"

#, python-brace-format
msgid "Only one source answers: {first}. Use this rate?"
msgstr "Solo responde una fuente: {first}. ¿Usas este tipo de cambio?"

#, python-brace-format
msgid ""
"No source answers. The last good rate is {first}, from {age} ago. Use it?"
msgstr ""
"No responde ninguna fuente. El último tipo de cambio válido es {first}, de "
"hace {age}. ¿Lo usas?"

#, python-brace-format
msgid "Use {rate}"
msgstr "Usar {rate}"

msgid "Your Lightning wallet does not accept this amount: too high or too low."
msgstr ""
"Tu wallet Lightning no acepta este importe: demasiado alto o demasiado bajo."

msgid "Your Lightning wallet sent a wrong invoice: do not use it."
msgstr ""
"Tu wallet Lightning ha mandado una solicitud de pago equivocada: no la uses."

msgid ""
"Cannot check the payment with your Lightning wallet right now: still trying."
msgstr ""
"Ahora no consigo comprobar el pago con tu wallet Lightning: sigo "
"intentándolo."

msgid "I see the payment in my wallet"
msgstr "Veo el pago en mi wallet"

msgid "Marked as paid by you"
msgstr "Marcado como pagado por ti"

msgid "Waiting"
msgstr "Esperando"

msgid "Not checked: look in your wallet"
msgstr "No comprobado: mira en tu wallet"

#, python-brace-format
msgid "{count} min"
msgstr "{count} min"

#, python-brace-format
msgid "{count} h"
msgstr "{count} h"

#, python-brace-format
msgid "Paid into {address}"
msgstr "Cobrado en {address}"

#, python-format
msgid "You are signing in as %(email)s."
msgstr "Estás entrando como %(email)s."

#, python-format
msgid "This email will get you back into your account: %(email)s."
msgstr "Con este correo volverás a entrar en tu cuenta: %(email)s."

msgid "Too many new accounts from here: try again later."
msgstr "Demasiadas cuentas nuevas desde aquí: vuelve a intentarlo más tarde."

msgid "How to pay here"
msgstr "Cómo se paga aquí"

msgid "Ask to pay in bitcoin, with Lightning."
msgstr "Pide pagar con bitcoin, con Lightning."

msgid ""
"Ask to pay in bitcoin. Here it is on-chain: your wallet has to send on-"
"chain, not with Lightning."
msgstr ""
"Pide pagar con bitcoin. Aquí se paga on-chain: tu wallet tiene que enviar on-"
"chain, no con Lightning."

msgid "Ask to pay in bitcoin."
msgstr "Pide pagar con bitcoin."

msgid ""
"Ask to pay in bitcoin: Lightning or on-chain, whichever your wallet uses."
msgstr ""
"Pide pagar con bitcoin: con Lightning u on-chain, como lo haga tu wallet."

msgid "The till shows a QR code with the amount."
msgstr "La caja muestra un QR con el importe."

msgid "Scan it with your wallet, check the amount and confirm."
msgstr "Escanéalo con tu wallet, comprueba el importe y confirma."

msgid ""
"Scan it with your wallet and confirm. With Lightning it takes a few seconds."
msgstr ""
"Escanéalo con tu wallet y confirma. Con Lightning bastan unos segundos."

msgid "Show at the till"
msgstr "Enséñalo en la caja"

msgid "In our story"
msgstr "En nuestra historia"

msgid "Nearby"
msgstr "Aquí cerca"

#, python-format
msgid "%(distance)s, %(minutes)s min on foot"
msgstr "%(distance)s, %(minutes)s min a pie"

msgid "I would like to pay in bitcoin."
msgstr "Quisiera pagar con bitcoin."

msgid "I would like to pay in bitcoin, with Lightning."
msgstr "Quisiera pagar con bitcoin, con Lightning."

#, python-format
msgid "With the %(discount)s%% discount for paying in bitcoin, thank you."
msgstr "Con el descuento del %(discount)s %% por pagar con bitcoin, gracias."

msgid "Card for the till"
msgstr "Ficha para la caja"

msgid "The first day: {done} of {total} done"
msgstr "El primer día: {done} de {total} pasos hechos"

msgid "The first day: all done"
msgstr "El primer día: todo listo"

msgid "Done"
msgstr "Hecho"

msgid "To do"
msgstr "Por hacer"

msgid "Not up to you"
msgstr "No depende de ti"

msgid "A sale has been paid: the register works."
msgstr "Se ha pagado una venta: la caja funciona."

msgid "Try the register"
msgstr "Prueba la caja"

msgid "On the map"
msgstr "En el mapa"

msgid "The sign and the card for the till"
msgstr "El cartel y la ficha para la caja"

msgid "Whoever works with you has the register"
msgstr "Quien trabaja contigo tiene la caja"

#, python-format
msgid ""
"Open the register and pay yourself a small amount from another phone, as a "
"customer would. When it says “%(paid)s”, the register works."
msgstr ""
"Abre la caja y págate una pequeña cantidad desde otro móvil, como lo haría "
"un cliente. Cuando diga «%(paid)s», la caja funciona."

msgid "Customers find the shop on the map."
msgstr "Los clientes encuentran la tienda en el mapa."

msgid ""
"The position is missing: add it, and customers find the shop on the map."
msgstr ""
"Falta la ubicación: añádela y los clientes encontrarán la tienda en el mapa."

#, python-format
msgid ""
"The community has taken the shop off the map for now. To know why, write to "
"<a href=\"mailto:%(email)s\">%(email)s</a>."
msgstr ""
"Por ahora la comunidad ha quitado la tienda del mapa. Para saber por qué, "
"escribe a <a href=\"mailto:%(email)s\">%(email)s</a>."

msgid "The shop stays off the map and the lists, as agreed with the community."
msgstr ""
"La tienda se queda fuera del mapa y de las listas, como se acordó con la "
"comunidad."

msgid "Printed. You can print them again whenever you like."
msgstr "Impresos. Puedes volver a imprimirlos cuando quieras."

msgid ""
"Print the sign for the door or the counter, and the card for whoever stands "
"at the till."
msgstr ""
"Imprime el cartel para la puerta o el mostrador, y la ficha para quien está "
"en la caja."

msgid "Done. When someone new starts, give them the register and the card."
msgstr "Hecho. Cuando llegue alguien nuevo, dale la caja y la ficha."

#, python-format
msgid ""
"Whoever works with you opens the register on their phone: use “%(handover)s” "
"here below. Nobody works with you? Mark it done anyway."
msgstr ""
"Quien trabaja contigo abre la caja en su móvil: usa «%(handover)s» aquí "
"abajo. ¿No trabaja nadie contigo? Márcalo como hecho igualmente."

msgid "Untick"
msgstr "Quitar la marca"

msgid "Mark as done"
msgstr "Marcar como hecho"

msgid "At the till"
msgstr "En la caja"

msgid ""
"Print it on an A4 sheet and keep it at the till, next to the shop phone. "
"Whoever stands there finds everything on it, even without knowing anything "
"about bitcoin."
msgstr ""
"Imprímela en una hoja A4 y tenla en la caja, al lado del móvil de la tienda. "
"Quien esté en el mostrador encuentra en ella todo, aunque no sepa nada de "
"bitcoin."

msgid "Language of the card:"
msgstr "Idioma de la ficha:"

msgid "Card without the register code"
msgstr "La ficha sin el código de la caja"

msgid "Add the register code, for whoever works with you"
msgstr "Añade el código de la caja, para quien trabaja contigo"

msgid ""
"With the code on it, keep the card on your side of the counter: whoever "
"scans it opens the register."
msgstr ""
"Con el código, ten la ficha de tu lado del mostrador: quien lo escanee abre "
"la caja."

msgid "Bitcoin at the till"
msgstr "Bitcoin en la caja"

msgid ""
"The customer pays with an app on their phone, called a wallet. You only need "
"the register: the page that opens on the shop phone."
msgstr ""
"El cliente paga con una app en su móvil, la wallet. Tú solo necesitas la "
"caja: la página que se abre en el móvil de la tienda."

msgid "Taking a payment"
msgstr "Cómo se cobra"

msgid "Open the register on the shop phone."
msgstr "Abre la caja en el móvil de la tienda."

#, python-format
msgid "Press OK. The register shows a code and “%(waiting)s”."
msgstr "Pulsa OK. La caja muestra un código y «%(waiting)s»."

msgid ""
"Turn the phone towards the customer: they scan the code with their wallet "
"and confirm."
msgstr ""
"Gira el móvil hacia el cliente: escanea el código con su wallet y confirma."

#, python-format
msgid "If it does not scan, press “%(as_text)s”: the customer can copy it."
msgstr "Si no se lee, pulsa «%(as_text)s»: el cliente lo puede copiar."

msgid "How you know it has arrived"
msgstr "Cómo sabes que ha llegado"

#, python-format
msgid ""
"The register says “%(paid)s”, with a tick. Only then hand over the goods, "
"and press “%(again)s” for the next customer."
msgstr ""
"La caja dice «%(paid)s», con la marca de verificación. Solo entonces entrega "
"la mercancía, y pulsa «%(again)s» para el siguiente cliente."

msgid ""
"Look at the register, not at the customer's phone: only the register knows "
"that the money has arrived."
msgstr ""
"Mira la caja, no el móvil del cliente: solo la caja sabe que el dinero ha "
"llegado."

msgid "With Lightning it takes a few seconds."
msgstr "Con Lightning bastan unos segundos."

msgid "If the network is down"
msgstr "Si se va la conexión"

msgid "Check that the shop phone has Wi-Fi or mobile data."
msgstr "Comprueba que el móvil de la tienda tenga wifi o datos."

msgid "At the end of the day"
msgstr "Al final del día"

#, python-format
msgid "Tell the owner about every sale that did not end with “%(paid)s”."
msgstr "Avisa al dueño de cada venta que no haya terminado con «%(paid)s»."

msgid "Who to ask"
msgstr "A quién preguntar"

msgid "Owner:"
msgstr "Dueño:"

msgid "Phone:"
msgstr "Teléfono:"

#, python-format
msgid "About the register and the site: %(email)s"
msgstr "Sobre la caja y el sitio: %(email)s"

#, python-format
msgid "The guide for shops: %(guide)s"
msgstr "La guía para las tiendas: %(guide)s"

msgid "The register on your phone"
msgstr "La caja en tu móvil"

msgid ""
"Scan the code and add the page to the home screen. No sign-in needed: with "
"it one can only take payments, which go to the shop."
msgstr ""
"Escanea el código y añade la página a la pantalla de inicio. No hace falta "
"iniciar sesión: con la caja solo se puede cobrar, y el dinero va a la tienda."

msgid "Too many changes in a short time: wait a few minutes."
msgstr "Demasiados cambios en poco tiempo: espera unos minutos."

msgid "Page view"
msgstr "Vista de la página"

msgid "Private view"
msgstr "Vista privada"

msgid "Public view"
msgstr "Vista pública"

#, python-format
msgid "site mode: %(mode)s"
msgstr "modo del sitio: %(mode)s"

msgid "Hide the private part"
msgstr "Ocultar la parte privada"

msgid "Show the private part"
msgstr "Mostrar la parte privada"

msgid "Got it"
msgstr "Visto"

#, python-brace-format
msgid ""
"It works: the register will know when a payment arrives. Provider: "
"{provider}."
msgstr "Funciona: la caja sabrá cuándo llega un pago. Proveedor: {provider}."

#, python-brace-format
msgid "I cannot find {provider}: check what you wrote after the @."
msgstr "No encuentro {provider}: comprueba lo que has escrito después de la @."

#, python-brace-format
msgid "Did you mean {address}?"
msgstr "¿Querías decir {address}?"

msgid ""
"This is a request for one payment, not your Lightning address: in your "
"wallet, look for the address that looks like an email, name@provider."
msgstr ""
"Esto es la solicitud de un solo pago, no tu dirección Lightning: en la "
"wallet busca la dirección que se parece a un correo electrónico, "
"nombre@proveedor."

msgid ""
"Too many checks in a short time. You can go on: the address is checked again "
"when you create the shop."
msgstr ""
"Demasiadas pruebas en poco tiempo. Puedes seguir: la dirección se vuelve a "
"probar cuando creas la tienda."

msgid "Trying the address..."
msgstr "Probando la dirección..."

#, python-brace-format
msgid "Written as {address}."
msgstr "Escrita así: {address}."

msgid ""
"The check is taking too long. You can go on: the address is checked again "
"when you create the shop."
msgstr ""
"La prueba está tardando demasiado. Puedes seguir: la dirección se vuelve a "
"probar cuando creas la tienda."

msgid ""
"I could not check the address now. You can go on: it is checked again when "
"you create the shop."
msgstr ""
"Ahora no consigo probar la dirección. Puedes seguir: se vuelve a probar "
"cuando creas la tienda."

msgid "Where do I find it?"
msgstr "¿Dónde la encuentro?"

msgid ""
"Open your wallet and look under Receive: the Lightning address looks like an "
"email, name@provider. Some wallets show it in the settings or in your "
"profile."
msgstr ""
"Abre la wallet y mira en Recibir: la dirección Lightning se parece a un "
"correo electrónico, nombre@proveedor. Algunas wallets la muestran en los "
"ajustes o en el perfil."

msgid ""
"Not the long code that starts with lnbc: that one is good for a single "
"payment."
msgstr "No el código largo que empieza por lnbc: ese vale para un solo pago."

msgid ""
"The wallet must tell the register when a payment arrives, and not all of "
"them do. Paste the address here: we try it before creating the shop, and "
"tell you if it does not work."
msgstr ""
"La wallet tiene que saber decirle a la caja cuándo llega un pago, y no todas "
"lo hacen. Pega aquí la dirección: la probamos antes de crear la tienda, y te "
"decimos si no funciona."

msgid "The wallets that work with the register"
msgstr "Las wallets que funcionan con la caja"

msgid "today at {time}"
msgstr "hoy a las {time}"

msgid "yesterday at {time}"
msgstr "ayer a las {time}"

msgid "on {date} at {time}"
msgstr "el {date} a las {time}"

msgid ""
"Customers can pay and the money reaches your wallet, but the register keeps "
"waiting and does not say it is paid. Until this is fixed, check in your "
"wallet that each payment arrived before the customer leaves."
msgstr ""
"Los clientes pueden pagar y el dinero llega a tu wallet, pero la caja se "
"queda esperando y no dice que está pagado. Hasta que se arregle, comprueba "
"en la wallet que cada pago haya llegado antes de que el cliente se vaya."

msgid ""
"The register cannot take Lightning payments: customers cannot pay you in "
"bitcoin until it works again."
msgstr ""
"La caja no puede cobrar con Lightning: los clientes no pueden pagarte con "
"bitcoin hasta que vuelva a funcionar."

msgid "{shop}: Lightning payments work again"
msgstr "{shop}: los pagos Lightning vuelven a funcionar"

msgid ""
"Good news: the Lightning address of {shop}, {address}, works again. "
"Customers can pay you with Lightning, and the register sees their payments."
msgstr ""
"Buenas noticias: la dirección Lightning de {shop}, {address}, vuelve a "
"funcionar. Los clientes pueden pagarte con Lightning y la caja ve sus pagos."

msgid "There is nothing to do."
msgstr "No tienes que hacer nada."

msgid "{shop}: the register does not see Lightning payments arrive"
msgstr "{shop}: la caja no ve llegar los pagos Lightning"

msgid ""
"The Lightning address of {shop}, {address}, still receives payments, but "
"{since} it stopped telling the register when one arrives."
msgstr ""
"La dirección Lightning de {shop}, {address}, sigue recibiendo pagos, pero "
"{since} dejó de avisar a la caja cuando llega uno."

msgid ""
"1. Open your wallet and check that your Lightning address is still exactly "
"{address}."
msgstr ""
"1. Abre tu wallet y comprueba que tu dirección Lightning siga siendo "
"exactamente {address}."

msgid "{shop}: the register cannot take Lightning payments"
msgstr "{shop}: la caja no puede cobrar con Lightning"

msgid ""
"The Lightning address of {shop}, {address}, stopped answering {since}. We "
"tried it twice, some time apart."
msgstr ""
"La dirección Lightning de {shop}, {address}, dejó de responder {since}. La "
"hemos probado dos veces, con un intervalo de tiempo."

msgid ""
"1. Open your wallet and find your Lightning address, usually under Receive."
msgstr ""
"1. Abre tu wallet y busca tu dirección Lightning, normalmente en Recibir."

msgid "2. Check that it is still exactly {address}."
msgstr "2. Comprueba que siga siendo exactamente {address}."

msgid "What happened"
msgstr "Qué ha pasado"

msgid "What your customers see"
msgstr "Qué ven tus clientes"

msgid "What to do now"
msgstr "Qué hacer ahora"

msgid "We keep checking it, and we write to you when it works again."
msgstr "Seguimos comprobándola y te escribimos cuando vuelva a funcionar."

msgid "Your panel: {link}"
msgstr "Tu panel: {link}"

msgid "Lightning addresses of the shops:"
msgstr "Direcciones Lightning de las tiendas:"

msgid "{shop}: works again"
msgstr "{shop}: vuelve a funcionar"

msgid "{shop}: stopped confirming payments {since}"
msgstr "{shop}: dejó de confirmar los pagos {since}"

msgid "{shop}: stopped answering {since}"
msgstr "{shop}: dejó de responder {since}"

msgid "…and {count} more"
msgstr "…y {count} más"

msgid "Shops with a problem: {link}"
msgstr "Tiendas con un problema: {link}"

msgid "Works"
msgstr "Funciona"

msgid "Does not answer"
msgstr "No responde"

msgid "Does not confirm payments"
msgstr "No confirma los pagos"

msgid "Lightning address status"
msgstr "Estado de la dirección Lightning"

msgid "Lightning status since"
msgstr "Estado Lightning desde"

msgid "Lightning address last checked"
msgstr "Dirección Lightning comprobada por última vez"

msgid "Lightning address last worked"
msgstr "Dirección Lightning funcionando por última vez"

msgid "Not working"
msgstr "No funciona"

msgid "You already tried a few times: wait ten minutes and try again."
msgstr ""
"Ya lo has intentado varias veces: espera diez minutos y vuelve a intentarlo."

msgid ""
"You saved many times in a short while: wait a few minutes and try again."
msgstr ""
"Has guardado muchas veces en poco tiempo: espera unos minutos y vuelve a "
"intentarlo."

msgid "Too many checks right now: try again in a minute."
msgstr ""
"Demasiadas comprobaciones en este momento: vuelve a intentarlo dentro de un "
"minuto."

msgid "Checked again just now: it works."
msgstr "Comprobada de nuevo ahora mismo: funciona."

msgid "Checked again just now: it still does not work."
msgstr "Comprobada de nuevo ahora mismo: todavía no funciona."

#, python-format
msgid "Lightning address checked %(when)s: it works."
msgstr "Dirección Lightning comprobada %(when)s: funciona."

msgid "Lightning: the register does not see payments arrive"
msgstr "Lightning: la caja no ve llegar los pagos"

msgid "Lightning: your address does not answer"
msgstr "Lightning: tu dirección no responde"

#, python-format
msgid ""
"Your Lightning address still receives payments, but %(since)s it stopped "
"telling the register when one arrives."
msgstr ""
"Tu dirección Lightning sigue recibiendo pagos, pero %(since)s dejó de avisar "
"a la caja cuando llega uno."

#, python-format
msgid "Your Lightning address stopped answering %(since)s."
msgstr "Tu dirección Lightning dejó de responder %(since)s."

msgid "Checking… it can take half a minute"
msgstr "Comprobando… puede tardar medio minuto"

msgid "Try again now"
msgstr "Vuelve a probar ahora"

#, python-format
msgid "Last check: %(when)s."
msgstr "Última comprobación: %(when)s."

msgid "Not checked yet"
msgstr "Todavía no comprobada"

msgid ""
"We tried the Lightning address of {shop}, {address}, twice, some time apart: "
"it receives payments, but it does not tell the register when one arrives."
msgstr ""
"Hemos probado dos veces, con un intervalo de tiempo, la dirección Lightning "
"de {shop}, {address}: recibe los pagos, pero no le dice a la caja cuándo "
"llega uno."

msgid ""
"We tried the Lightning address of {shop}, {address}, twice, some time apart, "
"and it did not answer."
msgstr ""
"Hemos probado dos veces, con un intervalo de tiempo, la dirección Lightning "
"de {shop}, {address}, y no ha respondido."

msgid ""
"{failed} of {probed} addresses failed at the same time: probably the network "
"of this server or a big provider, not the shops. Nothing was counted and no "
"merchant was told; the next run tries again."
msgstr ""
"{failed} direcciones de {probed} han fallado a la vez: probablemente la red "
"de este servidor o un proveedor grande, no las tiendas. No se ha contado "
"nada y no se ha avisado a ningún comerciante; la próxima vuelta lo vuelve a "
"intentar."

msgid "{shop}: does not confirm payments"
msgstr "{shop}: no confirma los pagos"

msgid "{shop}: does not answer"
msgstr "{shop}: no responde"

msgid ""
"Your Lightning address receives payments, but it does not tell the register "
"when one arrives: we tried it twice, some time apart."
msgstr ""
"Tu dirección Lightning recibe los pagos, pero no le dice a la caja cuándo "
"llega uno: la hemos probado dos veces, con un intervalo de tiempo."

msgid ""
"Your Lightning address does not answer: we tried it twice, some time apart."
msgstr ""
"Tu dirección Lightning no responde: la hemos probado dos veces, con un "
"intervalo de tiempo."

msgid ""
"Your wallet's provider is slow or busy right now: try again in a few minutes."
msgstr ""
"El proveedor de tu wallet está lento u ocupado en este momento: vuelve a "
"intentarlo dentro de unos minutos."

msgid "Your shop changed while it was being checked: look at it again."
msgstr "Tu tienda ha cambiado mientras la comprobábamos: vuelve a mirarla."

msgid "a first paid sale"
msgstr "una primera venta pagada"

msgid "the position on the map"
msgstr "la ubicación en el mapa"

msgid "the sign printed"
msgstr "el cartel impreso"

msgid "the register shown to the staff"
msgstr "la caja enseñada a quien trabaja contigo"

msgid ""
"The association has taken your shop off the map and the lists for now. The "
"register still works."
msgstr ""
"Por ahora la asociación ha quitado tu tienda del mapa y de las listas. La "
"caja funciona igualmente."

msgid ""
"Your shop is not shown on the map or in the lists, as you chose. The "
"register works the same."
msgstr ""
"Tu tienda no aparece en el mapa ni en las listas, como has elegido tú. La "
"caja funciona igualmente."

msgid ""
"Nobody has claimed this shop yet: it is on the map, but it has no register "
"on this site."
msgstr ""
"Nadie ha reclamado todavía esta tienda: está en el mapa, pero no tiene caja "
"en este sitio."

msgid ""
"This shop belongs to a staff account, which signs in only from the "
"administration and does not open the pages of a shop: the shop needs an "
"ordinary account."
msgstr ""
"Esta tienda pertenece a una cuenta del staff, que solo entra desde la "
"administración y no abre las páginas de una tienda: la tienda necesita una "
"cuenta normal."

msgid ""
"You can sign in with a link sent to your email, even without the wallet."
msgstr ""
"Puedes entrar con un enlace enviado a tu correo, incluso sin la wallet."

msgid ""
"There is no email to get back in: if you lose or change the wallet you sign "
"in with, you cannot open your shop any more. Add an email in your profile."
msgstr ""
"No hay un correo para volver a entrar: si pierdes o cambias la wallet con la "
"que entras, ya no podrás abrir tu tienda. Añade un correo en tu perfil."

msgid ""
"Your Lightning wallet takes too long to answer: the customer would wait too "
"long. Try again in a few minutes; if it stays so, check the wallet app."
msgstr ""
"Tu wallet Lightning tarda demasiado en responder: el cliente esperaría "
"demasiado. Vuelve a intentarlo dentro de unos minutos; si sigue así, revisa "
"la app de la wallet."

msgid "The first day is complete."
msgstr "El primer día está completo."

msgid "Some checks did not finish in time: run it again in a minute."
msgstr ""
"Algunas comprobaciones no han terminado a tiempo: vuelve a lanzarlo dentro "
"de un minuto."

msgid ""
"Your shop has no position, so it is not on the map. Add it in your shop page."
msgstr ""
"Tu tienda no tiene ubicación, así que no está en el mapa. Añádela en la "
"página de tu tienda."

#, python-brace-format
msgid "The first day: {done} of {total} done. Still to do: {steps}."
msgstr "El primer día: {done} de {total} hechos. Falta: {steps}."

#, python-brace-format
msgid ""
"Your shop is marked as historic ({note}): it stays on the map but does not "
"count among the places to pay. The register and the sign still work."
msgstr ""
"Tu tienda está marcada como histórica ({note}): se queda en el mapa pero no "
"cuenta entre los sitios donde pagar. La caja y el cartel siguen funcionando."

msgid "Your shop is on the map."
msgstr "Tu tienda está en el mapa."

msgid ""
"Your Lightning wallet is not answering: the register cannot show the "
"Lightning payment code. Open the wallet app and check that it works."
msgstr ""
"Tu wallet Lightning no responde: la caja no puede mostrar el código de pago "
"Lightning. Abre la app de la wallet y comprueba que funcione."

msgid ""
"Your Lightning address answers and tells the register when a payment arrives."
msgstr ""
"Tu dirección Lightning responde y avisa a la caja cuando llega un pago."

msgid ""
"One check could not be done: run it again; if it repeats, tell whoever runs "
"the server."
msgstr ""
"No se ha podido hacer una comprobación: vuelve a lanzarlo; si se repite, "
"avisa a quien gestiona el servidor."

#, python-brace-format
msgid "No shop found for “{text}”."
msgstr "No se ha encontrado ninguna tienda para «{text}»."

#, python-brace-format
msgid "{count} shops found: run it again with the id of the right one."
msgstr ""
"{count} tiendas encontradas: vuelve a lanzarlo con el id de la correcta."

msgid "certified since the month of"
msgstr "certificado desde el mes de"

msgid "Lightning, active in the last week"
msgstr "Lightning, activo en la última semana"

msgid "Lightning, active in the last month"
msgstr "Lightning, activo en el último mes"

msgid "Lightning, active in the last year"
msgstr "Lightning, activo en el último año"

msgid "Lightning, not active in the last year"
msgstr "Lightning, sin actividad en el último año"

msgid "Certified shop"
msgstr "Comercio certificado"

msgid "certified shop"
msgstr "comercio certificado"

msgid "Certified"
msgstr "Certificado"

msgid "Not yet"
msgstr "Todavía no"

msgid "certificate revoked"
msgstr "certificado revocado"

msgid "Revoke the certificate"
msgstr "Revocar el certificado"

msgid "Allow the certificate again"
msgstr "Volver a admitir el certificado"

msgid "Certificate revoked for %(count)d shops."
msgstr "Certificado revocado para %(count)d tiendas."

# The merchant's path (templates/shops/journey.html)
msgid "Your card on the map, now"
msgstr "Tu ficha en el mapa, ahora"

msgid "Not on the map for now: the community has taken the shop off it."
msgstr "Por ahora no está en el mapa: la comunidad ha quitado la tienda."

msgid "Not on the map: the shop stays off it, as agreed with the community."
msgstr ""
"No está en el mapa: la tienda se queda fuera, como se acordó con la "
"comunidad."

msgid "Not on the map yet: the position is missing."
msgstr "Todavía no está en el mapa: falta la ubicación."

msgid "Lightning address that works"
msgstr "Una dirección Lightning que funcione"

msgid "The first day"
msgstr "El primer día"

msgid "The badge of a certified shop"
msgstr "El distintivo de comercio certificado"

msgid "Next step"
msgstr "Siguiente paso"

msgid "Optional"
msgstr "Opcional"

msgid "Checked soon"
msgstr "Se comprobará pronto"

msgid "Your Lightning address works: checked %(when)s."
msgstr "Tu dirección Lightning funciona: comprobada %(when)s."

msgid ""
"Your Lightning address is not working: the message above says what to do."
msgstr ""
"Tu dirección Lightning no funciona: el mensaje de arriba dice qué hacer."

msgid ""
"The site tries your Lightning address within a few hours, the way the "
"register uses it. Nothing to do."
msgstr ""
"El sitio prueba tu dirección Lightning en unas pocas horas, como la usa la "
"caja. No tienes que hacer nada."

msgid "The shop is off the map for now: its Lightning address is not checked."
msgstr ""
"Por ahora la tienda no está en el mapa: su dirección Lightning no se "
"comprueba."

msgid ""
"The register works, the sign is up and whoever works with you has the "
"register."
msgstr ""
"La caja funciona, el cartel está colgado y quien trabaja contigo tiene la "
"caja."

msgid ""
"Try the register, print the sign, give the register to whoever works with "
"you: the steps are here below."
msgstr ""
"Prueba la caja, imprime el cartel, dale la caja a quien trabaja contigo: los "
"pasos están aquí abajo."

msgid "Certified since %(month)s: the badge is on your card."
msgstr "Certificado desde %(month)s: el distintivo está en tu ficha."

msgid ""
"The community has taken the badge off. To know why, write to <a "
"href=\"mailto:%(email)s\">%(email)s</a>."
msgstr ""
"La comunidad ha quitado el distintivo. Para saber por qué, escribe a <a "
"href=\"mailto:%(email)s\">%(email)s</a>."

msgid "Transaction"
msgstr "Transacción"

msgid "waiting"
msgstr "esperando"

msgid "Who will use it"
msgstr "Quién la usará"

msgid ""
"A first name or a word you recognise, for example «Anna» or «evening shift». "
"It shows at the top of the register's screen."
msgstr ""
"Un nombre o una palabra que reconozcas, por ejemplo «Ana» o «turno de "
"tarde». Se ve arriba en la pantalla de la caja."

msgid "Write a name."
msgstr "Escribe un nombre."

msgid "Too many registers turned on: turn off the ones nobody uses any more."
msgstr "Demasiadas cajas encendidas: apaga las que ya no usa nadie."

#, python-brace-format
msgid ""
"«{name}» is turned off: it takes no more payments. If the person needs a "
"register again, add a new one."
msgstr ""
"«{name}» está apagada: ya no cobra. Si esa persona vuelve a necesitar una "
"caja, añade una nueva."

msgid "Asking the shop's Lightning wallet for the invoice..."
msgstr "Pidiendo la solicitud de pago a la wallet Lightning de la tienda..."

msgid ""
"The shop's Lightning wallet does not accept this amount: too high or too low."
msgstr ""
"La wallet Lightning de la tienda no acepta este importe: demasiado alto o "
"demasiado bajo."

msgid "The shop's Lightning wallet sent a wrong invoice: do not use it."
msgstr ""
"La wallet Lightning de la tienda ha mandado una solicitud de pago "
"equivocada: no la uses."

msgid "The owner sees the payment in the wallet"
msgstr "El dueño ve el pago en la wallet"

msgid "Marked as paid: the owner will check it"
msgstr "Marcada como pagada: la comprobará el dueño"

msgid "Not checked: tell the owner"
msgstr "No comprobada: díselo al dueño"

#, python-format
msgid "Registers for your staff: 1 turned on"
msgid_plural "Registers for your staff: %(counter)s turned on"
msgstr[0] "Cajas para quien trabaja contigo: 1 encendida"
msgstr[1] "Cajas para quien trabaja contigo: %(counter)s encendidas"

msgid "Give a register to someone"
msgstr "Dale una caja a alguien"

msgid "Or share your own register"
msgstr "O comparte tu caja"

msgid ""
"Cancel this sale? If the customer has already paid, tell the owner: they "
"give the money back."
msgstr ""
"¿Anular esta venta? Si el cliente ya ha pagado, díselo al dueño: es él quien "
"devuelve el dinero."

msgid "Something is not right?"
msgstr "¿Algo va mal?"

msgid "Did the customer pay?"
msgstr "¿Ha pagado el cliente?"

msgid ""
"Only when this screen shows the green tick and «Payment received». «Sent» on "
"the customer's phone is not enough."
msgstr ""
"Solo cuando esta pantalla muestra la marca verde y «Pago recibido». "
"«Enviado» en el móvil del cliente no basta."

msgid "I typed the wrong amount"
msgstr "Me he equivocado de importe"

msgid ""
"If the customer has not paid yet: press Cancel and type it again. If they "
"already paid: tell the owner the time and the amount, they give the "
"difference back."
msgstr ""
"Si el cliente todavía no ha pagado: pulsa Cancelar y vuelve a escribirlo. Si "
"ya ha pagado: dile al dueño la hora y el importe, es él quien devuelve la "
"diferencia."

msgid "The phone switched off, or I closed the page"
msgstr "El móvil se ha apagado, o he cerrado la página"

msgid ""
"Open the register again on the same phone: the sale comes back and says how "
"it ended. On another phone it does not: tell the owner the time and the "
"amount."
msgstr ""
"Vuelve a abrir la caja en el mismo móvil: la venta vuelve y dice cómo "
"terminó. En otro móvil no: dile al dueño la hora y el importe."

msgid "The customer paid twice"
msgstr "El cliente ha pagado dos veces"

msgid ""
"This register only takes payments for the shop. The money goes to the owner, "
"never to this phone."
msgstr ""
"Esta caja solo sirve para cobrar para la tienda. El dinero va al dueño, "
"nunca a este móvil."

msgid "Registers for your staff"
msgstr "Cajas para quien trabaja contigo"

#, python-format
msgid "The register for %(name)s"
msgstr "La caja para %(name)s"

msgid ""
"Open the camera of the phone that will take payments and point it at this "
"code."
msgstr "Abre la cámara del móvil que va a cobrar y apunta a este código."

msgid "Open the link and press «Open the register on this phone»."
msgstr "Abre el enlace y pulsa «Abre la caja en este móvil»."

msgid ""
"From the browser menu, add the page to the home screen: it opens like an app."
msgstr ""
"Desde el menú del navegador, añade la página a la pantalla de inicio: se "
"abre como una app."

msgid "Code that puts the register on a phone"
msgstr "Código que pone la caja en un móvil"

#, python-format
msgid ""
"The code works once, until %(date)s. After that it opens nothing: a photo of "
"it is no use to anyone."
msgstr ""
"El código funciona una sola vez, hasta el %(date)s. Después no abre nada: "
"una foto de él no le sirve a nadie."

msgid "Send it as a link instead"
msgstr "Mándalo como enlace"

msgid "Print the card"
msgstr "Imprime la ficha"

msgid "Give the card to the person, do not leave it at the till."
msgstr "Dale la ficha a la persona, no la dejes en la caja."

#, python-format
msgid "This register was opened on a phone on %(date)s."
msgstr "Esta caja se abrió en un móvil el %(date)s."

msgid "The code to open this register has expired."
msgstr "El código para abrir esta caja ha caducado."

msgid ""
"Need it on another phone, or the person lost it? Make a new code: the phones "
"that already have the register keep it."
msgstr ""
"¿Hace falta en otro móvil, o la persona lo ha perdido? Crea un código nuevo: "
"los móviles que ya tienen la caja la conservan."

msgid "Make a new code (this one stops working)"
msgstr "Crear un código nuevo (este deja de funcionar)"

msgid "Make a new code"
msgstr "Crear un código nuevo"

msgid ""
"If the phone is lost or the person leaves, turn off the register instead: a "
"new code does not take it away from the phones that have it."
msgstr ""
"Si el móvil se ha perdido o la persona se va, apaga mejor la caja: un código "
"nuevo no se la quita a los móviles que ya la tienen."

msgid "Too many tries"
msgstr "Demasiados intentos"

msgid "Wait ten minutes and try again."
msgstr "Espera diez minutos y vuelve a intentarlo."

#, python-format
msgid ""
"The shop's register for %(name)s. With it you take payments for the shop: "
"the money goes to the owner."
msgstr ""
"La caja de la tienda para %(name)s. Con ella cobras para la tienda: el "
"dinero va al dueño."

msgid "Open the register on this phone"
msgstr "Abre la caja en este móvil"

msgid ""
"The code works only once: then the register stays on this phone. Add it to "
"the home screen from the browser menu."
msgstr ""
"El código funciona una sola vez: luego la caja se queda en este móvil. "
"Añádela a la pantalla de inicio desde el menú del navegador."

msgid "This code opens nothing"
msgstr "Este código no abre nada"

msgid ""
"It was already used, it expired, or the register was turned off. Ask the "
"owner of the shop for a new code."
msgstr ""
"Ya se ha usado, ha caducado, o la caja se ha apagado. Pide un código nuevo "
"al dueño de la tienda."

msgid ""
"When someone stops working with you, or loses the phone, turn off their "
"register: it stops at once, the others keep working."
msgstr ""
"Cuando alguien deja de trabajar contigo, o pierde el móvil, apaga su caja: "
"se detiene al momento, las demás siguen funcionando."

msgid "Turned on"
msgstr "Encendidas"

#, python-format
msgid "Opened on a phone on %(date)s."
msgstr "Abierta en un móvil el %(date)s."

msgid "Not opened on a phone yet: the code is waiting."
msgstr "Todavía no se ha abierto en un móvil: el código está esperando."

msgid "Not opened on a phone yet."
msgstr "Todavía no se ha abierto en un móvil."

msgid "Put it on a phone"
msgstr "Ponla en un móvil"

#, python-format
msgid "Turn off «%(name)s»"
msgstr "Apagar «%(name)s»"

msgid "None yet."
msgstr "Todavía ninguna."

msgid "Add a register"
msgstr "Añade una caja"

msgid "Add the register"
msgstr "Añadir la caja"

#, python-format
msgid "1 register turned off"
msgid_plural "%(counter)s registers turned off"
msgstr[0] "1 caja apagada"
msgstr[1] "%(counter)s cajas apagadas"

#, python-format
msgid "%(name)s, turned off on %(date)s"
msgstr "%(name)s, apagada el %(date)s"

#, python-format
msgid ""
"<a href=\"%(url)s\">Your own register</a> is for you: it cannot be turned "
"off, so do not give its link to anyone."
msgstr ""
"<a href=\"%(url)s\">Tu caja</a> es para ti: no se puede apagar, así que no "
"le des su enlace a nadie."

msgid "moved here on"
msgstr "llegó aquí el"

msgid "id on the other site"
msgstr "id en el otro sitio"

msgid "had a register on the other site"
msgstr "tenía una caja en el otro sitio"

msgid "Its owner's email is not valid: left out."
msgstr "El correo de su dueño no es válido: se ha dejado fuera."

msgid "Its owner cannot be found here: assign it from the admin."
msgstr "Aquí no se encuentra al dueño: asígnalo desde la administración."

msgid "A shop with the same external id is already set up here: left as it is."
msgstr ""
"Aquí ya hay una tienda configurada con el mismo id externo: se deja como "
"está."

msgid "Another shop here has the same unique value (Nostr name or id)."
msgstr "Otra tienda de aquí tiene el mismo valor único (nombre Nostr o id)."

#, python-format
msgid "with your email %(email)s (we send you a link)"
msgstr "con tu correo %(email)s (te mandamos un enlace)"

#, python-format
msgid ""
"Your shop %(name)s has moved to %(site)s. Sign in there %(how)s: your page "
"and its details are already there."
msgstr ""
"Tu tienda %(name)s se ha trasladado a %(site)s. Entra allí %(how)s: ya "
"encontrarás tu página con sus datos."

msgid ""
"To take payments again, connect your wallet from your shops' page: your "
"Lightning address, your on-chain key, or both, as before. Until then the "
"shop is not on the map."
msgstr ""
"Para volver a cobrar, conecta tu wallet desde la página de tus tiendas: tu "
"dirección Lightning, tu clave on-chain o las dos, como antes. Hasta entonces "
"la tienda no está en el mapa."

msgid ""
"To take payments again, connect your wallet from your shops' page, with your "
"Lightning address, as before. Until then the shop is not on the map."
msgstr ""
"Para volver a cobrar, conecta tu wallet desde la página de tus tiendas, con "
"tu dirección Lightning, como antes. Hasta entonces la tienda no está en el "
"mapa."

msgid ""
"Then print the new sign: the old one leads to the old site. If someone else "
"takes payments with you, send them the new register link."
msgstr ""
"Luego imprime el cartel nuevo: el antiguo lleva al sitio antiguo. Si alguien "
"más cobra contigo, mándale el enlace nuevo de la caja."

msgid "Nothing else to do."
msgstr "No hay nada más que hacer."

msgid "Your shop has arrived here"
msgstr "Tu tienda ha llegado aquí"

msgid ""
"Its page and details came with it. To take payments here, connect your "
"wallet: it takes two minutes. Until then the shop is not on the map."
msgstr ""
"La página y los datos han llegado con ella. Para cobrar aquí, conecta tu "
"wallet: se tarda dos minutos. Hasta entonces la tienda no está en el mapa."

msgid "Connect your wallet"
msgstr "Conecta tu wallet"

msgid ""
"If someone else takes payments with you, send them the new register link."
msgstr "Si alguien más cobra contigo, mándale el enlace nuevo de la caja."

#, python-format
msgid "Its Nostr name %(name)s cannot be used here: it arrives without one."
msgstr "Su nombre Nostr %(name)s no se puede usar aquí: llega sin él."

msgid ""
"Its owner's email already has an account here: the shop waits for a one-time "
"link."
msgstr ""
"El correo del dueño ya tiene una cuenta aquí: la tienda espera un enlace de "
"un solo uso."

msgid ""
"Its owner signs in with a wallet only, which has another key on another "
"site: the shop waits for a one-time link."
msgstr ""
"El dueño entra solo con la wallet, que en otro sitio tiene otra clave: la "
"tienda espera un enlace de un solo uso."

#, python-format
msgid "%(count)s shops here have the external id %(id)s."
msgstr "Aquí %(count)s tiendas tienen el id externo %(id)s."

msgid "with your wallet (scan the code on the sign-in page)"
msgstr "con tu wallet (escanea el código en la página de acceso)"

msgid "[the link is made with --apply]"
msgstr "[el enlace se crea con --apply]"

#, python-format
msgid ""
"Your shop %(name)s has moved to %(site)s. Sign in there %(how)s, then open "
"this link to take it back: %(link)s. It works once, for whoever opens it "
"first: do not pass it on."
msgstr ""
"Tu tienda %(name)s se ha trasladado a %(site)s. Entra allí %(how)s y luego "
"abre este enlace para recuperarla: %(link)s. Funciona una sola vez, para "
"quien lo abra primero: no se lo pases a nadie."

#, python-format
msgid "%(name)s is in your account now."
msgstr "%(name)s ya está en tu cuenta."

msgid "Take back your shop"
msgstr "Recupera tu tienda"

msgid "Too many tries in a short time: wait an hour and open the link again."
msgstr ""
"Demasiados intentos en poco tiempo: espera una hora y vuelve a abrir el "
"enlace."

#, python-format
msgid ""
"This link does not work: it was already used, or it is not complete. Write "
"to <a href=\"mailto:%(email)s\">%(email)s</a>."
msgstr ""
"Este enlace no funciona: ya se ha usado, o no está completo. Escribe a <a "
"href=\"mailto:%(email)s\">%(email)s</a>."

#, python-format
msgid "Take back %(name)s"
msgstr "Recupera %(name)s"

msgid ""
"Your shop has moved to this site. Confirm, and it goes into the account you "
"are signed in with now: then connect your wallet to take payments."
msgstr ""
"Tu tienda se ha trasladado a este sitio. Confirma, y pasará a la cuenta con "
"la que has entrado ahora: luego conecta tu wallet para cobrar."

msgid "The link works once. If this is not your shop, do not confirm."
msgstr "El enlace funciona una sola vez. Si no es tu tienda, no confirmes."

msgid "Yes, it is my shop"
msgstr "Sí, es mi tienda"

msgid "To do today"
msgstr "Por hacer hoy"

msgid "The whole site"
msgstr "Todo el sitio"

#, python-format
msgid "%(count)d more thing to know: --all, or /admin/today/."
msgid_plural "%(count)d more things to know: --all, or /admin/today/."
msgstr[0] "Queda %(count)d cosa por saber: --all, o /admin/today/."
msgstr[1] "Quedan %(count)d cosas por saber: --all, o /admin/today/."

msgid "The shop in the administration"
msgstr "La tienda en la administración"

msgid ""
"The Lightning address receives payments but does not tell the register: "
"sales stay waiting."
msgstr ""
"La dirección Lightning recibe los pagos pero no se lo dice a la caja: las "
"ventas se quedan en espera."

msgid ""
"The Lightning address has never answered: customers cannot pay with "
"Lightning."
msgstr ""
"La dirección Lightning no ha respondido nunca: los clientes no pueden pagar "
"con Lightning."

msgid ""
"The Lightning address stopped answering: customers cannot pay with Lightning."
msgstr ""
"La dirección Lightning ha dejado de responder: los clientes no pueden pagar "
"con Lightning."

msgid ""
"Open your wallet and check that your Lightning address is still the one in "
"your shop page."
msgstr ""
"Abre tu wallet y comprueba que tu dirección Lightning siga siendo la de la "
"página de la tienda."

msgid "The shop has no position, so it is not on the map."
msgstr "La tienda no tiene ubicación, así que no está en el mapa."

msgid "Moved here: the owner has not taken the shop yet."
msgstr "Trasladada aquí: el dueño todavía no ha recuperado la tienda."

msgid ""
"Your shop has moved to this site: open the link we sent you to take it back."
msgstr ""
"Tu tienda se ha trasladado a este sitio: abre el enlace que te hemos mandado "
"para recuperarla."

msgid "Moved here without an owner to tell."
msgstr "Trasladada aquí sin un dueño al que avisar."

msgid ""
"Moved here: the owner took the shop but has not connected a wallet, so there "
"is no register."
msgstr ""
"Trasladada aquí: el dueño ha recuperado la tienda pero no ha conectado una "
"wallet, así que no hay caja."

msgid "Moved here: the owner took the shop, which has no register yet."
msgstr ""
"Trasladada aquí: el dueño ha recuperado la tienda, que todavía no tiene caja."

msgid "Help the merchant connect a wallet from their panel: only they can."
msgstr ""
"Ayuda al comerciante a conectar una wallet desde su panel: solo puede "
"hacerlo él."

msgid "To take payments again, open your panel and connect your wallet."
msgstr "Para volver a cobrar, abre tu panel y conecta tu wallet."

msgid ""
"The Lightning addresses have not been checked for a while: what this page "
"says about them may be old."
msgstr ""
"Hace tiempo que no se comprueban las direcciones Lightning: lo que esta "
"página dice de ellas puede estar desfasado."

msgid "The Lightning addresses have never been checked."
msgstr "Las direcciones Lightning no se han comprobado nunca."

msgid "Check the timer that runs check_lightning."
msgstr "Revisa el temporizador que lanza check_lightning."

msgid "To do today: the state of every register"
msgstr "Por hacer hoy: el estado de todas las cajas"

msgid "shops to look at"
msgstr "tiendas que mirar"

msgid "Problem"
msgstr "Problema"

msgid "To look at"
msgstr "Para revisar"

msgid "To know"
msgstr "Para saber"

msgid "Now:"
msgstr "Ahora:"

msgid "To the merchant:"
msgstr "Al comerciante:"

msgid "Nothing to do: every register is fine, as far as the database knows."
msgstr ""
"Nada que hacer: todas las cajas van bien, por lo que sabe la base de datos."

msgid "What this page does not see"
msgstr "Lo que esta página no ve"

msgid "The same list in text, for a daily message:"
msgstr "La misma lista en texto, para un aviso diario:"

#, python-format
msgid "%(count)s thing to do, the most urgent first"
msgid_plural "%(count)s things to do, the most urgent first"
msgstr[0] "%(count)s cosa por hacer, la más urgente primero"
msgstr[1] "%(count)s cosas por hacer, las más urgentes primero"

#, python-format
msgid "Last time %(when)s, %(days)s day ago."
msgid_plural "Last time %(when)s, %(days)s days ago."
msgstr[0] "La última vez %(when)s, hace %(days)s día."
msgstr[1] "La última vez %(when)s, hace %(days)s días."

#, python-format
msgid "Last time %(when)s."
msgstr "La última vez %(when)s."

#, python-format
msgid "Started %(when)s, %(days)s day ago."
msgid_plural "Started %(when)s, %(days)s days ago."
msgstr[0] "Empezó %(when)s, hace %(days)s día."
msgstr[1] "Empezó %(when)s, hace %(days)s días."

#, python-format
msgid "Started %(when)s."
msgstr "Empezó %(when)s."

msgid ""
"Send the owner again the one-time link from the list of owners the import "
"wrote. If that link is lost, the command below makes a new one for this shop "
"only, from the same file of the import, in a new list of owners: the old "
"link stops working, the other shops keep theirs."
msgstr ""
"Vuelve a mandar al dueño el enlace de un solo uso, de la lista de dueños que "
"escribió la importación. Si ese enlace se ha perdido, el comando de aquí "
"abajo crea uno nuevo solo para esta tienda, a partir del mismo archivo de la "
"importación, en una nueva lista de dueños: el enlace antiguo deja de "
"funcionar, las demás tiendas conservan el suyo."

msgid "in the browser"
msgstr "en el navegador"

msgid "I do not have a wallet yet: save my shop, I add the wallet afterwards"
msgstr "Todavía no tengo wallet: guarda la tienda, la wallet la añado después"

msgid "waiting for the owner's wallet"
msgstr "esperando la wallet del dueño"

msgid "Last step: the wallet."
msgstr "Último paso: la wallet."

msgid ""
"Your shop's page is ready. It goes on the map, with its register, as soon as "
"you add the wallet where the money arrives."
msgstr ""
"La página de la tienda está lista. Entra en el mapa, con su caja, en cuanto "
"añadas la wallet donde llega el dinero."

msgid "Add the wallet"
msgstr "Añadir la wallet"

msgid "No wallet yet: your shop is not on the map and has no register."
msgstr "Todavía sin wallet: la tienda no está en el mapa y no tiene caja."

msgid "Last step: the wallet for %(name)s"
msgstr "Último paso: la wallet para %(name)s"

msgid "Your shop is saved."
msgstr "La tienda está guardada."

msgid "It goes on the map, with its register, as soon as you add the wallet."
msgstr "Entra en el mapa, con su caja, en cuanto añadas la wallet."

msgid ""
"The wallet is the app on your phone where the money arrives. Getting one is "
"free and takes about ten minutes. You can stop and come back: this page is "
"in your shops."
msgstr ""
"La wallet es la app del móvil donde llega el dinero. Tener una es gratis y "
"se tarda unos diez minutos. Puedes pararte y volver: esta página la "
"encuentras entre tus tiendas."

msgid "Already have a wallet? Go to step 4."
msgstr "¿Ya tienes una wallet? Ve al paso 4."

msgid "Choose a wallet"
msgstr "Elige una wallet"

msgid ""
"These wallets are free and the money stays yours: nobody else can move it, "
"not even us. Any of them is fine."
msgstr ""
"Estas wallets son gratuitas y el dinero sigue siendo tuyo: nadie más puede "
"moverlo, ni siquiera nosotros. Cualquiera de ellas sirve."

msgid "Pick one from our page: they are free, and the money stays yours."
msgstr ""
"Elige una de nuestra página: son gratuitas, y el dinero sigue siendo tuyo."

msgid ""
"Ask us which wallet to use: write to <a href=\"mailto:%(email)s\">%(email)s</"
"a>."
msgstr ""
"Pregúntanos qué wallet usar: escribe a <a href=\"mailto:%(email)s\">%"
"(email)s</a>."

msgid "Install it"
msgstr "Instálala"

msgid ""
"Open the app store of your phone, look for the wallet by its name and "
"install it, as you do with any app."
msgstr ""
"Abre la tienda de aplicaciones del móvil, busca la wallet por su nombre e "
"instálala, como haces con cualquier app."

msgid ""
"Check the name of whoever makes it: it must be the same as on the wallet's "
"page. There are fake copies."
msgstr ""
"Comprueba el nombre de quien la hace: tiene que ser el mismo que en la "
"página de la wallet. Existen copias falsas."

msgid "Create your wallet"
msgstr "Crea tu wallet"

msgid ""
"Never write those words here, nor in a photo, a message or an email. Nobody "
"from us will ever ask you for them."
msgstr ""
"No escribas nunca esas palabras aquí, ni en una foto, un mensaje o un "
"correo. Ninguno de nosotros te las pedirá nunca."

msgid "Copy your Lightning address"
msgstr "Copia tu dirección Lightning"

msgid ""
"In the wallet, look under Receive, or in the settings or in your profile: "
"the Lightning address looks like an email, name@provider. Copy it."
msgstr ""
"En la wallet mira en Recibir, o en los ajustes o en el perfil: la dirección "
"Lightning se parece a un correo electrónico, nombre@proveedor. Cópiala."

msgid "Paste it here: we try it"
msgstr "Pégala aquí: la probamos"

msgid ""
"The check is taking too long. You can go on: the address is checked again "
"when you make the register."
msgstr ""
"La comprobación está tardando demasiado. Puedes seguir: la dirección se "
"vuelve a probar cuando crees la caja."

msgid ""
"I could not check the address now. You can go on: it is checked again when "
"you make the register."
msgstr ""
"Ahora no he podido comprobar la dirección. Puedes seguir: se vuelve a probar "
"cuando crees la caja."

msgid ""
"As soon as you paste it, we try the address and tell you here if it works. "
"Not all wallets tell the register when a payment arrives: if yours does not, "
"we say so, and you can pick another one from step 1."
msgstr ""
"En cuanto la pegues, probamos la dirección y te decimos aquí si funciona. No "
"todas las wallets avisan a la caja cuando llega un pago: si la tuya no lo "
"hace te lo decimos, y puedes elegir otra en el paso 1."

msgid "Make the register"
msgstr "Crea la caja"

msgid ""
"When the address works, press the button: we try it once more and make your "
"register. Then try it: pay yourself a small amount from another phone."
msgstr ""
"Cuando la dirección funcione, pulsa el botón: la probamos una última vez y "
"creamos tu caja. Luego pruébala: págate una pequeña cantidad desde otro "
"móvil."

msgid "Make my register"
msgstr "Crear mi caja"

msgid "Making your register..."
msgstr "Creando tu caja..."

msgid ""
"Your shop was already saved a moment ago, without a wallet. Paste the "
"address here: we try it and make the register."
msgstr ""
"La tienda ya se había guardado hace un momento, sin wallet. Pega aquí la "
"dirección: la probamos y creamos la caja."

msgid "This shop does not take bitcoin yet: it will soon."
msgstr "Esta tienda todavía no acepta bitcoin: pronto sí."

msgid ""
"Once the wallet is connected, print the new sign from here: the old one "
"leads to the old site."
msgstr ""
"Una vez conectada la wallet, imprime desde aquí el cartel nuevo: el antiguo "
"lleva al sitio antiguo."

msgid ""
"Your shop changed while the wallet was being connected: reload the page and "
"look at it again."
msgstr ""
"La tienda ha cambiado mientras se conectaba la wallet: recarga la página y "
"vuelve a mirarla."

msgid "PRACTICE ONLY. This is not a payment: there is nothing to pay."
msgstr "SOLO PRÁCTICA. Esto no es un pago: no hay nada que pagar."

msgid ""
"The customer paid. Hand over the goods only when this screen shows the green "
"tick and «Payment received»: the customer's phone does not count."
msgstr ""
"El cliente ha pagado. Entrega la mercancía solo cuando esta pantalla muestre "
"la marca verde y «Pago recibido»: el móvil del cliente no cuenta."

msgid ""
"No connection, as when the shop's Wi-Fi drops. The register says so and "
"keeps the sale: do not cancel it and do not hand over the goods. Wait for "
"the connection."
msgstr ""
"Sin conexión, como cuando se cae el wifi de la tienda. La caja lo dice y "
"guarda la venta: no la anules y no entregues la mercancía. Espera a la "
"conexión."

msgid "The connection is back: the register asks at once how the sale went."
msgstr ""
"Ha vuelto la conexión: la caja pregunta enseguida cómo ha ido la venta."

msgid ""
"The phone switched off and you opened the register again: the sale comes "
"back by itself and says how it ended."
msgstr ""
"El móvil se ha apagado y has vuelto a abrir la caja: la venta vuelve sola y "
"dice cómo terminó."

msgid "Type an amount and press OK: then the pretend customer can pay."
msgstr ""
"Escribe un importe y pulsa OK: luego el cliente de mentira puede pagar."

msgid "The customer has the code in front of them. Choose what they do."
msgstr "El cliente tiene el código delante. Elige qué hace."

msgid "Exercise done: {name}."
msgstr "Ejercicio hecho: {name}."

msgid "All the exercises are done. Now the real thing."
msgstr "Has hecho todos los ejercicios. Ahora la de verdad."

msgid "The next sale is real. The first times, ask the owner to stay close."
msgstr ""
"La próxima venta es de verdad. Las primeras veces, pide al dueño que esté "
"cerca."

msgid "Back to the register"
msgstr "Volver a la caja"

msgid "Open the real register"
msgstr "Abre la caja de verdad"

msgid ""
"Now a real sale: open the register and pay yourself a small amount from "
"another phone."
msgstr ""
"Ahora una venta de verdad: abre la caja y págate una pequeña cantidad desde "
"otro móvil."

msgid "Go to the first day"
msgstr "Ve al primer día"

msgid ""
"To take real payments the shop needs its wallet: it takes a few minutes."
msgstr ""
"Para cobrar de verdad la tienda necesita su wallet: se tarda unos minutos."

msgid "The next sale is real."
msgstr "La próxima venta es de verdad."

msgid "Practice"
msgstr "Práctica"

msgid "No real money: nothing here is a payment."
msgstr "Nada de dinero real: aquí nada es un pago."

msgid "The pretend customer"
msgstr "El cliente de mentira"

msgid "Pays"
msgstr "Paga"

msgid "Does not pay"
msgstr "No paga"

msgid "The connection drops"
msgstr "Se cae la conexión"

msgid "The connection is back"
msgstr "Vuelve la conexión"

msgid "The phone switches off"
msgstr "El móvil se apaga"

msgid ""
"Without JavaScript the practice register does not move. Read the exercises "
"here below: each one says what the register shows and what you do."
msgstr ""
"Sin JavaScript la caja de prueba no se mueve. Lee los ejercicios de aquí "
"abajo: cada uno dice qué muestra la caja y qué haces tú."

msgid "Exercises"
msgstr "Ejercicios"

msgid "Take 3.50"
msgstr "Cobra 3,50"

msgid "Type 3, 5, 0 and press OK. Then press «Pays»."
msgstr "Escribe 3, 5, 0 y pulsa OK. Luego pulsa «Paga»."

msgid "When do you hand over the goods?"
msgstr "¿Cuándo entregas la mercancía?"

msgid ""
"When the register shows the green tick and «Payment received». Not before."
msgstr "Cuando la caja muestra la marca verde y «Pago recibido». No antes."

msgid "The customer says they paid, but the register is waiting"
msgstr "El cliente dice que ha pagado, pero la caja espera"

msgid ""
"Start a sale, press «The connection drops», then «Pays». The customer shows "
"you «Sent» on their phone."
msgstr ""
"Empieza una venta, pulsa «Se cae la conexión» y luego «Paga». El cliente te "
"enseña «Enviado» en su móvil."

msgid "What do you do?"
msgstr "¿Qué haces?"

msgid ""
"Do not hand over the goods yet, and do not cancel the sale. Only the green "
"tick on this screen counts. Wait for the connection: the register keeps the "
"sale and says how it ended."
msgstr ""
"No entregues todavía la mercancía, y no anules la venta. Solo cuenta la "
"marca verde de esta pantalla. Espera a la conexión: la caja guarda la venta "
"y dice cómo terminó."

msgid "The phone switches off during a sale"
msgstr "El móvil se apaga durante una venta"

msgid "Start a sale, press «The phone switches off», then «Pays»."
msgstr "Empieza una venta, pulsa «El móvil se apaga» y luego «Paga»."

msgid "Now the real thing"
msgstr "Ahora la de verdad"

msgid "Start the practice again"
msgstr "Volver a empezar la práctica"

msgid "Practise without money"
msgstr "Prueba sin dinero"

msgid "Practise first, without money"
msgstr "Prueba primero, sin dinero"

msgid "code for the customer to scan, which no wallet can pay"
msgstr "código que escanea el cliente, que ninguna wallet puede pagar"

msgid "password"
msgstr "contraseña"

msgid "A password was set or changed on your account."
msgstr "Se ha puesto o cambiado una contraseña en tu cuenta."

msgid "access to the admin"
msgstr "acceso a la administración"

msgid "Your account was given, or lost, access to the site's administration."
msgstr ""
"A tu cuenta se le ha dado (o quitado) el acceso a la administración del "
"sitio."

msgid "all rights in the admin"
msgstr "todos los derechos en la administración"

msgid "Your account was given, or lost, all the rights over the site."
msgstr ""
"A tu cuenta se le han dado (o quitado) todos los derechos sobre el sitio."

msgid "switched on or off"
msgstr "activada o desactivada"

msgid "Your account was switched on or off."
msgstr "Tu cuenta se ha activado o desactivado."

msgid "name it signs in with"
msgstr "nombre con el que entra"

msgid "The name your account signs in with was replaced by another one."
msgstr "El nombre con el que entra tu cuenta se ha sustituido por otro."

msgid "groups"
msgstr "grupos"

msgid "The rights of your account were changed."
msgstr "Se han cambiado los derechos de tu cuenta."

msgid "permissions"
msgstr "permisos"

msgid "owner of a shop"
msgstr "dueño de una tienda"

msgid "A shop of yours was handed to another account."
msgstr "Una tienda tuya se ha pasado a otra cuenta."

msgid "Telegram chat of a shop"
msgstr "chat de Telegram de una tienda"

msgid ""
"The Telegram chat that receives the notices of a shop of yours was changed."
msgstr ""
"Se ha cambiado el chat de Telegram que recibe los avisos de una tienda tuya."

msgid "account deleted"
msgstr "cuenta eliminada"

msgid "Your account was deleted."
msgstr "Tu cuenta se ha eliminado."

msgid "the admin"
msgstr "desde la administración"

msgid "the pages of the site"
msgstr "desde las páginas del sitio"

msgid "a command or the shell"
msgstr "desde un comando o la shell"

#, python-brace-format
msgid ""
"If you know why, you do not need to do anything. If you do not, write to "
"{email} now."
msgstr ""
"Si sabes por qué, no tienes que hacer nada. Si no lo sabes, escribe "
"enseguida a {email}."

msgid ""
"If you know why, you do not need to do anything. If you do not, tell the "
"association now."
msgstr ""
"Si sabes por qué, no tienes que hacer nada. Si no lo sabes, avisa enseguida "
"a la asociación."

#, python-brace-format
msgid "Someone who runs the site changed your account on {site}:"
msgstr "Alguien que gestiona el sitio ha cambiado tu cuenta en {site}:"

#, python-brace-format
msgid "Shops on your account: {shops}."
msgstr "Tiendas de tu cuenta: {shops}."

