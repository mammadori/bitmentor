msgstr "Guardámos o teu número de IVA, mas pode ter um erro. %(why)s"

msgid "Saved. This is what your customers see now."
msgstr "Guardado. É isto que os teus clientes veem agora."

msgid "May have a mistake"
msgstr "Pode ter um erro"

msgid "Written"
msgstr "Escrito"

msgid "Not written"
msgstr "Não escrito"

