msgid "Map"
msgstr "Carte"

msgid "For shops"
msgstr "Pour les commerces"

msgid "Where to pay in bitcoin"
msgstr "Où payer en bitcoin"

msgid "Your shops"
msgstr "Vos commerces"

msgid "Open register"
msgstr "Ouvrir la caisse"

msgid "No shops yet."
msgstr "Aucun commerce pour l'instant."

msgid "Add a shop"
msgstr "Ajouter un commerce"

msgid "Save"
msgstr "Enregistrer"

msgid "Never enter your seed phrase or a private key here."
msgstr ""
"Ne saisissez jamais ici votre phrase de récupération (seed) ni une clé "
"privée."

msgid "Cancel"
msgstr "Annuler"

msgid "New payment"
msgstr "Nouveau paiement"

msgid "Payment received"
msgstr "Paiement reçu"

