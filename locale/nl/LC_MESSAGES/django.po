msgstr "Je winkels"

msgid "Open register"
msgstr "Kassa openen"

msgid "No shops yet."
msgstr "Nog geen winkels."

msgid "Add a shop"
msgstr "Winkel toevoegen"

msgid "Save"
msgstr "Opslaan"

msgid "Never enter your seed phrase or a private key here."
msgstr "Typ hier nooit je herstelwoorden (seed) of een privésleutel."

msgid "Cancel"
msgstr "Annuleren"

msgid "New payment"
msgstr "Nieuwe betaling"

msgid "Payment received"
msgstr "Betaling ontvangen"

