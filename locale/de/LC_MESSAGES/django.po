msgstr "Nicht geprüft: {count}. Suchen Sie sie in Ihrem Wallet."

#, python-brace-format
msgid "Not paid (expired or cancelled): {count}"
msgstr "Nicht bezahlt (abgelaufen oder abgebrochen): {count}"

#, python-brace-format
msgid "The passphrase must be at least {count} characters long."
msgstr "Das Passwort muss mindestens {count} Zeichen lang sein."

