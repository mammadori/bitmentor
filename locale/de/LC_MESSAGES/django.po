msgstr "On-Chain: nein. Um es hinzuzufügen, stellen Sie es in den Einstellungen Ihrer Kasse auf diesem Telefon ein und kommen Sie dann hierher zurück."

#, python-brace-format
msgid "Discount {discount}%, currency {currency}, a confirmation above {above}."
msgstr "Rabatt {discount}%, Währung {currency}, eine Bestätigung über {above}."

#, python-brace-format
