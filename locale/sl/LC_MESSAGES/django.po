msgstr "Stanje"

msgid "Payment method"
msgstr "Način plačila"

msgid "Description"
msgstr "Opis"

msgid "Month"
msgstr "Mesec"

msgid "Map of the places"
msgstr "Zemljevid krajev"

msgid "Zoom in"
msgstr "Povečajte"

