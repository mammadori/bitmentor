msgstr "Skupnost ste vprašali %(when)s."

#, python-format
msgid "Done %(when)s."
msgstr "Opravljeno %(when)s."

#, python-format
msgid "Write to %(email)s and we look at it together."
msgstr "Pišite na %(email)s in pogledamo skupaj."

#, python-format
msgid ""
"The last check did not find it there: it may have been moved or deleted. "
