msgstr "Modo di pagamento"

msgid "Description"
msgstr "Descrizione"

msgid "Month"
msgstr "Mese"

msgid "Map of the places"
msgstr "Mappa dei luoghi"

msgid "Zoom in"
msgstr "Ingrandisci"

msgid "Zoom out"
msgstr "Rimpicciolisci"

