msgstr "gennaio"

msgid "February"
msgstr "febbraio"

msgid "March"
msgstr "marzo"

msgid "April"
msgstr "aprile"

msgid "May"
msgstr "maggio"

msgid "June"
msgstr "giugno"

msgid "July"
msgstr "luglio"

